# Normalize all text files to LF in the repo
* text=auto eol=lf

# Explicitly declare common text files
*.html text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.env  text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
